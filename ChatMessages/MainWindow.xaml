<Window x:Class="ChatMessages.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatMessages"
        mc:Ignorable="d"
        Title="Chat Messages" Height="560" Width="920" Background="#FF111827">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Chat Room" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,16,0" />
                    <TextBlock Text="Username" Foreground="#FF9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="UserNameTextBox" Width="180" Height="28" Background="#FF111827" Foreground="White" BorderBrush="#FF374151" Margin="0,0,10,0" Padding="6,2" />
                    <Button x:Name="ConnectButton" Width="100" Height="28" Content="Connect" Background="#FF2563EB" Foreground="White" BorderBrush="#FF2563EB" Click="ConnectButton_Click" />
                </StackPanel>
                <Border Grid.Column="1" Background="#FF111827" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Foreground="#FF34D399" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FF1F2937" CornerRadius="8" Padding="12">
            <ListBox x:Name="MessagesListBox" Background="Transparent" Foreground="White" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Background" Value="#FF111827" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderBrush" Value="#FF374151" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Background="#FF1F2937" CornerRadius="8" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageTextBox" Grid.Column="0" Height="36" Background="#FF111827" Foreground="White" BorderBrush="#FF374151" Padding="8,4" Margin="0,0,10,0" />
                <Button x:Name="SendButton" Grid.Column="1" Width="110" Height="36" Content="Send" Background="#FF22C55E" Foreground="White" BorderBrush="#FF22C55E" Click="SendButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
